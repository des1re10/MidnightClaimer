# MidnightClaimer - Git Ignore File
# SECURITY: Prevent accidental commit of sensitive files

# ===============================================
# CRITICAL: PRIVATE KEYS AND SENSITIVE DATA
# ===============================================

# Environment files containing seed phrases and sensitive data
.env
.env.*
*.env

# Generated private key files (CLI)
*.skey
*.vkey
*.addr
*.cert

# Generated private key files (GUI)
midnight_payment_*.skey
midnight_stake_*.skey
midnight_bitcoin_private_*.wif
*.wif

# Output directories with generated keys
output/
keys/
workspace/
midnight_claim/
bitcoin_claim_output/
**/Midnight Claim/

# Success and diagnostic files containing sensitive information
MIDNIGHT_SUCCESS_*.txt
MIDNIGHT_BITCOIN_SUCCESS_*.txt
CARDANO_INSTRUCTIONS_*.txt
BITCOIN_INSTRUCTIONS_*.txt
DIAGNOSTIC_REPORT_*.txt
BITCOIN_DIAGNOSTIC_REPORT_*.txt
comprehensive_test.py

