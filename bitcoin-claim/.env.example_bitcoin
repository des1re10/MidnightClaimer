# Bitcoin Midnight Claim Configuration
# Copy this file to .env and replace ALL placeholder values with your actual information

# CRITICAL: Replace with your actual seed phrase (12 or 24 words, space-separated)
# Example: word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12
TREZOR_SEED_PHRASE=your actual twelve or twenty four word mnemonic seed phrase goes here

# Replace with your actual passphrase (or leave completely empty if you don't use one)
# Example: MySecretPassphrase123
# Important: Leave completely empty (no quotes) if you don't use a passphrase
TREZOR_PASSPHRASE=

# Replace with your eligible Bitcoin address from Midnight Portal
# Supported formats:
# Legacy (P2PKH): 1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa
# SegWit (P2SH-P2WPKH): 3J98t1WpEZ73CNmQviecrnyiWrnqRhWNLy
# Native SegWit (P2WPKH): bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4
ELIGIBLE_BITCOIN_ADDRESS=

# Bitcoin address type override (optional - auto-detected from address format)
# Options: legacy, segwit, native_segwit
# Leave empty for automatic detection based on address format
BITCOIN_ADDRESS_TYPE=

# Account number (usually 0 for most users)
# Only change if you know your eligible address is from a different account
BITCOIN_ACCOUNT=0

# Address index within the account (usually 0 for the first address)
# Only change if you know your eligible address is not the first address
BITCOIN_ADDRESS_INDEX=0

# Example complete configuration:
# TREZOR_SEED_PHRASE=abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about
# TREZOR_PASSPHRASE=
# ELIGIBLE_BITCOIN_ADDRESS=bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4
# BITCOIN_ADDRESS_TYPE=
# BITCOIN_ACCOUNT=0
# BITCOIN_ADDRESS_INDEX=0

# SECURITY REMINDERS:
# 1. This file contains your seed phrase - treat it as highly sensitive
# 2. Never commit this file to version control
# 3. Delete this file immediately after successful claiming
# 4. Only use this on your OLD wallet - never on your primary wallet with funds
# 5. Transfer all funds to a NEW wallet before running this script